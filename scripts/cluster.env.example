# Per-cluster overrides for the OMC pickup loop — copy to ~/.config/omc/cluster.env
# on each cluster and edit. Sourced by omc-pickup-loop.sh at job start and by
# omc-pickup.sh every cycle, so an edit takes effect within ~5 minutes without
# restarting the loop job.
#
# Everything here is optional. A cluster with Alliance's national layout
# (apptainer on PATH, $HOME/scratch, a `_cpu` allocation) needs no file at all.
#
# Sourced under `set -u`: guard anything that reads a possibly-unset variable.

# ── Identity ────────────────────────────────────────────────────────────────
# The name the portal pins submissions to. Alliance sets CC_CLUSTER, which is
# what the loop falls back to; set this only where that is missing or wrong.
# Never leave it as a login node's hostname — grex's login node is `bison`.
#OMC_CLUSTER=grex

# ── SLURM ───────────────────────────────────────────────────────────────────
# Allocation to charge. Passed on the sbatch command line, which beats the
# #SBATCH --account directive the portal bakes into each pipeline script.
# fir: def-rec3141_cpu   grex: def-rec3141
#OMC_ACCOUNT=def-rec3141

# Memory tiers (GB) the OOM retry escalates through. A tier larger than the
# biggest node this account can reach will sit PENDING forever, so trim the list
# to what the cluster actually has.
#OMC_MEM_TIERS="128 187 249 373 498"

# ── Paths ───────────────────────────────────────────────────────────────────
# Defaults are $HOME/scratch and $HOME/GENICE. Point these at project storage on
# a cluster with no scratch filesystem, or symlink $HOME/scratch there instead.
#OMC_SCRATCH=/project/6043541/rec3141/scratch
#OMC_GENICE=/project/6043541/rec3141/GENICE
#OMC_DB_DIR=/project/6043541/rec3141/scratch/databases

# ── Container runtime ───────────────────────────────────────────────────────
# The portal's amplicon step invokes this binary directly; danaSeq's run-*.sh
# --container finds its own from PATH. Expect to need a module load: on every
# cluster so far the runtime is one, and a batch job that does not inherit it
# from the submitting shell cannot run a container at all.
#
# Alliance clusters (fir, nibi) have Lmod live in a batch job, so this is enough:
#if ! command -v apptainer >/dev/null 2>&1; then
#    module load apptainer >/dev/null 2>&1 || echo "WARNING: module load apptainer failed"
#fi
#
# grex has SingularityCE instead, no apptainer at all, and a batch job there
# starts without Lmod — so the module system has to be initialised first, and its
# init reads unset variables, hence lifting nounset and putting it back only if
# it was on.
#if ! command -v module >/dev/null 2>&1 && [ -f /etc/profile.d/z09-modules.sh ]; then
#    case $- in *u*) _omc_nounset=1 ;; *) _omc_nounset=0 ;; esac
#    set +u
#    . /etc/profile.d/z09-modules.sh
#    [ "$_omc_nounset" = 1 ] && set -u
#    unset _omc_nounset
#fi
#module load singularity/4.4.1 >/dev/null 2>&1
#OMC_APPTAINER=singularity

# ── PATH ────────────────────────────────────────────────────────────────────
# The loop runs as a batch job, and on a cluster whose batch jobs start without
# SLURM's own binaries on PATH nothing works: the watchdog can't sbatch a
# successor, the heartbeat's squeue counts read 0, and Phase 2 can't submit a
# pipeline. Pipeline jobs inherit whatever is set here via `--export=ALL`.
#if ! command -v sbatch >/dev/null 2>&1 && [ -d /opt/slurm/bin ]; then
#    PATH=/opt/slurm/bin:$PATH
#    LD_LIBRARY_PATH=/opt/slurm/lib:${LD_LIBRARY_PATH:-}
#    export PATH LD_LIBRARY_PATH
#fi
