[Unit]
Description=OMC Download Worker — processes queued SRA downloads
After=network.target

[Service]
Type=simple
User=ubuntu
ExecStart=/opt/omc-platform/scripts/omc-download-worker.sh
Restart=always
RestartSec=10

Environment=OMC_STAGING_DIR=/data/sra_downloads
Environment=OMC_MAX_JOBS=3
Environment=OMC_POLL_INTERVAL=10

[Install]
WantedBy=multi-user.target
