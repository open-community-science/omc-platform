# OMC Portal Configuration
# Copy to .env and fill in values

DEBUG=true
SECRET_KEY=change-me-in-production

# Admin panel access — comma-separated GitHub logins granted /admin
# (not hardcoded; leave empty for none). Dev mode always grants the dev user.
ADMIN_GITHUB_LOGINS=

# GitHub OAuth (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/callback

# GitHub API token for repo creation (needs repo scope)
GITHUB_TOKEN=
GITHUB_ORG=omc-papers

# Claude API
ANTHROPIC_API_KEY=

# Database (SQLite for dev, Postgres for prod)
DATABASE_URL=sqlite+aiosqlite:///./omc.db

# SLURM (set SLURM_ENABLED=true for HPC integration)
SLURM_ENABLED=false
SLURM_HOST=
SLURM_USER=
SLURM_SSH_KEY=
SLURM_PARTITION=def-alloc
SLURM_ACCOUNT=

# Pipeline paths on HPC
PIPELINE_NANOPORE_MAG=/project/def-alloc/pipelines/nanopore_mag
PIPELINE_MICROSCAPE=/project/def-alloc/pipelines/microscape
RESULTS_PATH=/project/def-alloc/omc/results
