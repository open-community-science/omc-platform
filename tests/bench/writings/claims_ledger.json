      "code": "# Compute PCA ordination on relative abundance data (rows=samples)\n# Add small pseudocount to avoid zeros\nrel_counts = counts.div(counts.sum(axis=1), axis=0) + 1e-6\nrel_counts = rel_counts.div(rel_counts.sum(axis=1), axis=0)\n\npca = PCA(n_components=2)\npca_result = pca.fit_transform(rel_counts.values)\n\nsample_names = list(counts.index)\nresult = {sample_names[i]: [float(pca_result[i,0]), float(pca_result[i,1])] for i in range(len(sample_names))}\nresult[\"explained_variance\"] = {\n    \"PC1\": float(pca.explained_variance_ratio_[0]),\n    \"PC2\": float(pca.explained_variance_ratio_[1])\n}",
